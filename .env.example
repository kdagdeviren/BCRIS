# BCRIS Environment Variables - Coolify için Minimal Yapılandırma
# Coolify'da Environment Variables sekmesine bu değerleri girin

# ============================================
# ZORUNLU AYARLAR (Mutlaka değiştirin!)
# ============================================

# Django Secret Key (güçlü, rastgele bir key oluşturun)
# Oluşturmak için: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-very-long-random-secret-key-change-this

# Domain adınız (virgülle ayırarak birden fazla ekleyebilirsiniz)
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ============================================
# OPSİYONEL AYARLAR (Varsayılan değerler var)
# ============================================

# Debug modu (production'da False olmalı)
DJANGO_DEBUG=False

# Port (Coolify otomatik ayarlar, genellikle değiştirmeyin)
PORT=8000

# SSL/HTTPS ayarları (domain'iniz SSL sertifikası varsa True yapın)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ============================================
# EMAIL AYARLARI (Opsiyonel - mail göndermek için)
# ============================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
